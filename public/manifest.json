{
  "key": "",
  "manifest_version": 3,
  "name": "Plan / Actual / Revised",
  "description": "A personal plan, actual, and revised day planner.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/frog-full-16.png",
    "32": "icons/frog-full-32.png",
    "48": "icons/frog-full-48.png",
    "128": "icons/frog-full-128.png"
  },
  "action": {
    "default_title": "Plan / Actual / Revised",
    "default_icon": {
      "16": "icons/frog-full-16.png",
      "32": "icons/frog-full-32.png",
      "48": "icons/frog-full-48.png",
      "128": "icons/frog-full-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
